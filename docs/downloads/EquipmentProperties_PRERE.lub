      0
    },
    OnStartEquip = function()
      -- Indestructible (except in upgrade attempts).
      if (GetPureJob() == 2 or get(19) == 2 or get(19) == 9 or get(19) == 16 or get(19) == 4003 or get(19) == 4010 or get(19) == 4017 or get(19) == 4055 or get(19) == 4064 or get(19) == 4078 or get(19) == 4071 or get(19) == 4097 or get(19) == 4110 or get(19) == 4221) or (GetPureJob() == 3 or get(19) == 3 or get(19) == 11 or get(19) == 19 or get(19) == 20 or get(19) == 4004 or get(19) == 4012 or get(19) == 4020 or get(19) == 4021 or get(19) == 4056 or get(19) == 4063 or get(19) == 4071 or get(19) == 4098 or get(19) == 4111) or (GetPureJob() == 4 or get(19) == 4 or get(19) == 8 or get(19) == 15 or get(19) == 4005 or get(19) == 4009 or get(19) == 4016 or get(19) == 4057 or get(19) == 4065 or get(19) == 4099 or get(19) == 4112 or get(19) == 4223) then
      	-- Perfect Dodge + 5+(getequiprefinerycnt(EQI_GARMENT)*2) (scales with refine)
      	AddExtParam(0, 51, 5+(GetRefineLevel(4)*2))
      end
      if not ((GetPureJob() == 2 or get(19) == 2 or get(19) == 9 or get(19) == 16 or get(19) == 4003 or get(19) == 4010 or get(19) == 4017 or get(19) == 4055 or get(19) == 4064 or get(19) == 4078 or get(19) == 4071 or get(19) == 4097 or get(19) == 4110 or get(19) == 4221) or (GetPureJob() == 3 or get(19) == 3 or get(19) == 11 or get(19) == 19 or get(19) == 20 or get(19) == 4004 or get(19) == 4012 or get(19) == 4020 or get(19) == 4021 or get(19) == 4056 or get(19) == 4063 or get(19) == 4071 or get(19) == 4098 or get(19) == 4111) or (GetPureJob() == 4 or get(19) == 4 or get(19) == 8 or get(19) == 15 or get(19) == 4005 or get(19) == 4009 or get(19) == 4016 or get(19) == 4057 or get(19) == 4065 or get(19) == 4099 or get(19) == 4112 or get(19) == 4223)) then
      	if (GetPureJob() == 1 or get(19) == 1 or get(19) == 7 or get(19) == 14 or get(19) == 4002 or get(19) == 4008 or get(19) == 4014 or get(19) == 4015 or get(19) == 4022 or get(19) == 4054 or get(19) == 4060 or get(19) == 4066 or get(19) == 4096 or get(19) == 4109 or get(19) == 4220 or get(19) == 4302) or (GetPureJob() == 5 or get(19) == 5 or get(19) == 10 or get(19) == 18 or get(19) == 4006 or get(19) == 4011 or get(19) == 4019 or get(19) == 4058 or get(19) == 4068 or get(19) == 4100 or get(19) == 4113 or get(19) == 4224) or (GetPureJob() == 6 or get(19) == 6 or get(19) == 12 or get(19) == 17 or get(19) == 4007 or get(19) == 4013 or get(19) == 4018 or get(19) == 4059 or get(19) == 4072 or get(19) == 4101 or get(19) == 4114 or get(19) == 4225) then
      		-- Reflects 5+(getequiprefinerycnt(EQI_GARMENT)*2)% of received melee damage back to the attacker. (scales with refine)
      		AddMeleeAttackReflect(5+(GetRefineLevel(4)*2))
      	end
      end
    end,
    Combiitem = {3000000063},
  },
