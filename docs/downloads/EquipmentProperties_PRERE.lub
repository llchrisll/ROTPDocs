    OnStartEquip = function()
      -- TODO: if (BaseClass == Job_Swordman || BaseClass == Job_Merchant || BaseClass == Job_Thief || (BaseJob == Job_Taekwon && Class!=Job_Soul_Linker)) (condition not translatable)
      -- STR + 1
      AddExtParam(0, 103, 1)
      -- (else branch)
      -- When class is Mage / Acolyte / Ninja / Soul Linker:
      -- INT + 1
      AddExtParam(0, 106, 1)
      -- (else branch)
      if (GetPureJob() == 3 or get(19) == 3 or get(19) == 11 or get(19) == 19 or get(19) == 20 or get(19) == 4004 or get(19) == 4012 or get(19) == 4020 or get(19) == 4021 or get(19) == 4056 or get(19) == 4063 or get(19) == 4071 or get(19) == 4098 or get(19) == 4111) or (GetPureJob() == 24 or get(19) == 24 or get(19) == 4215 or get(19) == 4228 or get(19) == 4229) then
      	-- DEX + 1
      	AddExtParam(0, 107, 1)
      end
      if not ((GetPureJob() == 3 or get(19) == 3 or get(19) == 11 or get(19) == 19 or get(19) == 20 or get(19) == 4004 or get(19) == 4012 or get(19) == 4020 or get(19) == 4021 or get(19) == 4056 or get(19) == 4063 or get(19) == 4071 or get(19) == 4098 or get(19) == 4111) or (GetPureJob() == 24 or get(19) == 24 or get(19) == 4215 or get(19) == 4228 or get(19) == 4229)) then
      	-- When class is Novice / SuperNovice:
      	-- MaxHP + 80
      	AddExtParam(0, 109, 80)
      	-- MaxSP + 30
      	AddExtParam(0, 110, 30)
      end
    end,
  },
