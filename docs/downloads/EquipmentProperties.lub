  [313288] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Rhythm Shooting SP cost + 3.
      AddSkillSP(5355, 3)
      -- Rose Blossom SP cost + 7.
      AddSkillSP(5353, 7)
      -- Rhythm Shooting SP cost + 4. (refine >= 7)
      if r >= 7 then
        AddSkillSP(5355, 4)
        -- Rose Blossom SP cost + 8.
        AddSkillSP(5353, 8)
        -- Rhythm Shooting SP cost + 4. (refine >= 9)
        if r >= 9 then
          AddSkillSP(5355, 4)
          -- Rose Blossom SP cost + 8.
          AddSkillSP(5353, 8)
        end
      end
    end
  },
