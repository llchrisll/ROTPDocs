      0,
      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Ranged Damage + 15%
      -- Only One Bullet damage increased by 20%.
      AddDamage_SKID(1, 5406, 20)
      -- Fire Dance damage increased by 20%.
      AddDamage_SKID(1, 2561, 20)
      -- ASPD + 15% (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 167, 15)
        -- Basic ATK + 90
        AddExtParam(0, 41, 90)
        -- Increases physical damage against All monsters by 20%.
        -- Only One Bullet damage increased by 10%. (refine >= 9)
        if r >= 9 then
          AddDamage_SKID(1, 5406, 10)
          -- Fire Dance damage increased by 20%.
          AddDamage_SKID(1, 2561, 20)
          -- Only One Bullet SP cost + -20.
          AddSkillSP(5406, -20)
          -- Fire Dance SP cost + -20.
          AddSkillSP(2561, -20)
          -- Aftercast Delay - 15%. (refine >= 11)
          if r >= 11 then
            AddSpellDelay(-15)
            -- Only One Bullet damage increased by 10%.
            AddDamage_SKID(1, 5406, 10)
            -- Fire Dance damage increased by 10%.
            AddDamage_SKID(1, 2561, 10)
            -- Only One Bullet SP cost + -20.
            AddSkillSP(5406, -20)
            -- Fire Dance SP cost + -20.
            AddSkillSP(2561, -20)
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- PAtk + 10
      AddExtParam(0, 242, 10)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- Only One Bullet damage increased by 10%.
      AddDamage_SKID(1, 5406, 10)
      -- Fire Dance damage increased by 10%.
      AddDamage_SKID(1, 2561, 10)
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- Increase damage on All Property enemies by 10%.
      AddDamage_Property(10, 10)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- Only One Bullet damage increased by 10%.
      AddDamage_SKID(1, 5406, 10)
      -- Fire Dance damage increased by 10%.
      AddDamage_SKID(1, 2561, 10)
    end,
  },
