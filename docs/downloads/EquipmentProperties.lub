      AddExtParam(0, 47, r)
      -- DEF + 5*.@r (scales with refine)
      AddExtParam(0, 45, 5*(r))
      -- TODO: if (BaseClass == Job_Swordman || BaseClass == Job_Thief || (BaseClass == Job_Taekwon && BaseJob != Job_Soul_Linker)) (condition not translatable)
      -- ASPD + 1
      AddExtParam(0, 54, 1)
      -- (else branch)
      if (GetPureJob() == 5 or get(19) == 5 or get(19) == 10 or get(19) == 18 or get(19) == 4006 or get(19) == 4011 or get(19) == 4019 or get(19) == 4058 or get(19) == 4068 or get(19) == 4100 or get(19) == 4113 or get(19) == 4224) or (GetPureJob() == 3 or get(19) == 3 or get(19) == 11 or get(19) == 19 or get(19) == 20 or get(19) == 4004 or get(19) == 4012 or get(19) == 4020 or get(19) == 4021 or get(19) == 4056 or get(19) == 4063 or get(19) == 4071 or get(19) == 4098 or get(19) == 4111) or (GetPureJob() == 24 or get(19) == 24 or get(19) == 4215 or get(19) == 4228 or get(19) == 4229) then
      	-- Flee Rate + 15
      	AddExtParam(0, 50, 15)
      end
      if not ((GetPureJob() == 5 or get(19) == 5 or get(19) == 10 or get(19) == 18 or get(19) == 4006 or get(19) == 4011 or get(19) == 4019 or get(19) == 4058 or get(19) == 4068 or get(19) == 4100 or get(19) == 4113 or get(19) == 4224) or (GetPureJob() == 3 or get(19) == 3 or get(19) == 11 or get(19) == 19 or get(19) == 20 or get(19) == 4004 or get(19) == 4012 or get(19) == 4020 or get(19) == 4021 or get(19) == 4056 or get(19) == 4063 or get(19) == 4071 or get(19) == 4098 or get(19) == 4111) or (GetPureJob() == 24 or get(19) == 24 or get(19) == 4215 or get(19) == 4228 or get(19) == 4229)) then
      	if (GetPureJob() == 2 or get(19) == 2 or get(19) == 9 or get(19) == 16 or get(19) == 4003 or get(19) == 4010 or get(19) == 4017 or get(19) == 4055 or get(19) == 4064 or get(19) == 4078 or get(19) == 4071 or get(19) == 4097 or get(19) == 4110 or get(19) == 4221) or (GetPureJob() == 4 or get(19) == 4 or get(19) == 8 or get(19) == 15 or get(19) == 4005 or get(19) == 4009 or get(19) == 4016 or get(19) == 4057 or get(19) == 4065 or get(19) == 4099 or get(19) == 4112 or get(19) == 4223) or (GetPureJob() == 25 or get(19) == 25 or get(19) == 4211 or get(19) == 4212 or get(19) == 4222 or get(19) == 4223 or get(19) == 4224) or (GetPureJob() == 4049 or get(19) == 4049 or get(19) == 4227 or get(19) == 4240) then
      		-- MaxSP + 2%
      		AddExtParam(0, 112, 2)
      		-- Increases the effectiveness of healing skills by 3%.
      		AddExtParam(0, 254, 3)
      	end
      	if not ((GetPureJob() == 2 or get(19) == 2 or get(19) == 9 or get(19) == 16 or get(19) == 4003 or get(19) == 4010 or get(19) == 4017 or get(19) == 4055 or get(19) == 4064 or get(19) == 4078 or get(19) == 4071 or get(19) == 4097 or get(19) == 4110 or get(19) == 4221) or (GetPureJob() == 4 or get(19) == 4 or get(19) == 8 or get(19) == 15 or get(19) == 4005 or get(19) == 4009 or get(19) == 4016 or get(19) == 4057 or get(19) == 4065 or get(19) == 4099 or get(19) == 4112 or get(19) == 4223) or (GetPureJob() == 25 or get(19) == 25 or get(19) == 4211 or get(19) == 4212 or get(19) == 4222 or get(19) == 4223 or get(19) == 4224) or (GetPureJob() == 4049 or get(19) == 4049 or get(19) == 4227 or get(19) == 4240)) then
      		-- When class is Novice / Summoner:
      		-- Variable Cast Time + -5%
      		AddSpellCastTime(-5)
      		-- MaxSP + 300
      		AddExtParam(0, 110, 300)
      	end
      end
    end,
    Combiitem = {2000000661},
  },
