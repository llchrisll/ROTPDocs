    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MaxHP + 300*(.@r/2) (scales with refine)
      AddExtParam(0, 109, math.floor(300*((r)/2)))
      -- MaxSP + 50*(.@r/2) (scales with refine)
      AddExtParam(0, 110, math.floor(50*((r)/2)))
      -- Increases physical damage against All monsters by 5*(.@r/3)%.
      -- ATK + 5*(.@r/4)% (scales with refine)
      AddExtParam(0, 207, math.floor(5*((r)/4)))
      -- Ranged Damage + 10%
      -- Melee Damage + 10%
      -- PAtk + 8 (refine >= 9) (refine >= 7)
      if r >= 7 then
        if r >= 9 then
          AddExtParam(0, 242, 8)
          -- ASPD + 10% (refine >= 10)
          if r >= 10 then
            AddExtParam(0, 167, 10)
            -- Increases fixed cast time of all skills by Vms. (refine >= 11)
            if r >= 11 then
              AddSFCTEquipAmount(-500)
              -- CRIT + 10
              AddExtParam(0, 52, 10)
            end
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- PAtk + 7
      AddExtParam(0, 242, 7)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- Disregards 5% of the target's Res against All monsters.
      AddIgnore_RES_RacePercent(9999, 5)
      -- Disregards -5% of the target's Res against Player (Human) monsters.
      AddIgnore_RES_RacePercent(10, -5)
      -- Disregards -5% of the target's Res against Player (Doram) monsters.
      AddIgnore_RES_RacePercent(11, -5)
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- Increases physical damage to the All monster by 15%.
      RaceAddDamage(9999, 15)
      -- Increases physical damage to the Player (Human) monster by -15%.
      RaceAddDamage(10, -15)
      -- Increases physical damage to the Player (Doram) monster by -15%.
      RaceAddDamage(11, -15)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- Disregards 5% of the target's Res against All monsters.
      AddIgnore_RES_RacePercent(9999, 5)
      -- Disregards -5% of the target's Res against Player (Human) monsters.
      AddIgnore_RES_RacePercent(10, -5)
      -- Disregards -5% of the target's Res against Player (Doram) monsters.
      AddIgnore_RES_RacePercent(11, -5)
    end,
