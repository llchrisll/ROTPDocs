      0,
      0,
      0,
      0,
      0,
      2,
      0,
      0,
      0,
      0,
      0,
      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- All Trait Stats + 3
      AddExtParam(0, 234, 3)
      AddExtParam(0, 235, 3)
      AddExtParam(0, 236, 3)
      AddExtParam(0, 237, 3)
      AddExtParam(0, 238, 3)
      AddExtParam(0, 239, 3)
      -- Variable Cast Time + -10%
      AddSpellCastTime(-10)
      -- SMatk + 3 (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 243, 3)
        -- SMatk + 2*.@param
        -- WIS + 4*.@param
        -- Increases fixed cast time of all skills by Vms. (refine >= 12) (refine >= 9)
        if r >= 9 then
          if r >= 12 then
            AddSFCTEquipAmount(-300)
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- Increases MATK + 3%.
      AddExtParam(0, 140, 3)
      -- SPL + 2
      AddExtParam(0, 237, 2)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- SMatk + 2
      AddExtParam(0, 243, 2)
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- SMatk + 3
      AddExtParam(0, 243, 3)
      -- Res + 20
      AddExtParam(0, 244, 20)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- SPL + 2*(readparam(bInt)/15)
    end,
    OnStartPretendEquip = true
  },
