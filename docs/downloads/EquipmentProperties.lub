		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- MaxHP + 15%
			AddExtParam(0, 111, 15)
			-- MaxSP + 15%
			AddExtParam(0, 112, 15)
			-- Increases physical damage against All monsters by 15%.
			-- Increases magical damage against All monsters by 15%.
			-- Basic ATK + 175 (refine >= 11)
			if r >= 11 then
			  AddExtParam(0, 41, 175)
			  -- MATK + 175
			  AddExtParam(0, 200, 175)
			  -- Double Bowling Bash damage increased by 60%. (refine >= 12)
			  if r >= 12 then
