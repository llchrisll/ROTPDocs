  [13109] = {
    Type = "Rweapon",
    Stat = {
      0,
      100,
      0,
      0,
      0,
      0,
      0,
      0,
      3,
      0,
      0,
      0,
      0,
      0,
      0
    },
    OnStartEquip = function()
      -- HIT + readparam(bAgi)/10
      -- ASPD + readparam(bAgi)/14%
      -- Increases physical damage against All monsters by 40%.
      -- TODO: if (vip_status(VIP_STATUS_ACTIVE)) (condition not translatable)
      -- Basic ATK + 10
      AddExtParam(0, 41, 10)
      -- MATK + 10
      AddExtParam(0, 200, 10)
    end,
