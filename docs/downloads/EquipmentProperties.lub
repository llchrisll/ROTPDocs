    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      local dmg = 10
      local delay = -15-6*getskilllv("GN_CRAZYWEED")
      -- MDEF + 15
      AddExtParam(0, 47, 15)
      -- No Cast Cancel
