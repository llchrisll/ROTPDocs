	[3000000763] = {
		Item = { 5918, 19306 },
		OnStartEquip = function()
			local aspd = 1
			-- TODO unsafe expression (not emitted): local crit_dmg = 2 + 2 * (readparam(bDex) / 10)
			local sub_player = 2
			-- When luk > 107:
			aspd = aspd + 1
			crit_dmg = crit_dmg + 2
			sub_player = sub_player + 2
			-- When luk > 119:
			aspd = aspd + 2
			crit_dmg = crit_dmg + 4
			sub_player = sub_player + 4
			-- Sets splash attack radius to 1 cells (highest value applied).
			-- ASPD + .@aspd (scales with refine)
			AddExtParam(0, 54, aspd)
			-- Crit Damage + .@crit_dmg% (scales with refine)
			AddDamage_CRI(1, crit_dmg)
			-- Adds .@sub_player% tolerance against Player (Human) monster. (scales with refine)
			AddRaceTolerace(10, sub_player)
			-- Damage from skill Npc criticalslash + 100%
		end
	},
