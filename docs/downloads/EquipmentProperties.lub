    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MaxHP + 10%
      AddExtParam(0, 111, 10)
      -- After-cast Delay + 8-(2*(.@r/2))% (scales with refine)
      AddSpellDelay(math.floor(8-(2*((r)/2))))
      -- MaxHP + 3000*(.@r/3) (scales with refine)
      AddExtParam(0, 109, math.floor(3000*((r)/3)))
      -- Aftercast Delay - 10%. (refine >= 7)
      if r >= 7 then
        AddSpellDelay(-10)
        -- ATK + 10% (refine >= 9)
        if r >= 9 then
          AddExtParam(0, 207, 10)
          -- Increases MATK + 10%.
          AddExtParam(0, 140, 10)
          -- Increases physical damage to the All monster by 15%. (refine >= 11)
          if r >= 11 then
            RaceAddDamage(9999, 15)
            -- Increase magical damage against All monsters by 15%.
            AddMdamage_Race(9999, 15)
            -- Melee Damage Reduction + 10%
            -- Ranged Damage Reduction + 10% (refine >= 13)
            if r >= 13 then
            end
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- PAtk + 5
      AddExtParam(0, 242, 5)
      -- SMatk + 5
      AddExtParam(0, 243, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- MaxHP + 15000
      AddExtParam(0, 109, 15000)
      -- Aftercast Delay - 5%.
      AddSpellDelay(-5)
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- 2% chance on attack for 10s: All Magic Damage + 20%.
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- Add a 10% resistance against All Property attacks.
      AddAttrTolerace(10, 10)
    end
  },
