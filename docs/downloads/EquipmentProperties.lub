  [312692] = {
    Type = "card",
    OnStartEquip = function()
      -- Increases physical damage to the All monster by (getskilllv("ABC_FRENZY_SHOT")/2)%.
      RaceAddDamage(9999, (getskilllv("ABC_FRENZY_SHOT")/2))
      -- Increases physical damage to the Player (Human) monster by -(getskilllv("ABC_FRENZY_SHOT")/2)%.
      RaceAddDamage(10, -(getskilllv("ABC_FRENZY_SHOT")/2))
      -- Increases physical damage to the Player (Doram) monster by -(getskilllv("ABC_FRENZY_SHOT")/2)%.
      RaceAddDamage(11, -(getskilllv("ABC_FRENZY_SHOT")/2))
    end,
    OnStartPretendEquip = true,
    Combiitem = {
      2000003001,
      2000003002,
      2000003003
    },
  },
