	[3000001138] = {
		Item = { 15042, 22172 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- Movement Speed + 25%
			-- Crit Damage + 4*(readparam(bLuk)/20)%
			-- ASPD + 8% (refine >= 7)
			if r >= 7 then
			  AddExtParam(0, 167, 8)
			  -- Adds 8% tolerance against Demi-Human monster.
			  AddRaceTolerace(7, 8)
			  -- Adds 8% tolerance against Player (Human) monster.
			  AddRaceTolerace(10, 8)
			  -- Blitz Beat damage increased by 40%.
			  AddDamage_SKID(1, 129, 40)
			  -- Sharp Shooting damage increased by 50%.
			  AddDamage_SKID(1, 382, 50)
			end
			-- ASPD + 4% (refine >= 9)
			if r >= 9 then
			  AddExtParam(0, 167, 4)
			  -- Adds 4% tolerance against Demi-Human monster.
			  AddRaceTolerace(7, 4)
			  -- Adds 4% tolerance against Player (Human) monster.
			  AddRaceTolerace(10, 4)
			  -- Blitz Beat damage increased by 20%.
			  AddDamage_SKID(1, 129, 20)
			  -- Sharp Shooting damage increased by 25%.
			  AddDamage_SKID(1, 382, 25)
			end
		end
	},
	[3000001139] = {
		Item = { 15043, 22172 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- Recover 500 HP each time a monster is killed by melee.
			-- Movement Speed + 25%
			-- Cluster Bomb damage increased by 30*(readparam(bInt)/20)%.
			-- Electric Shock SP cost + 30.
			AddSkillSP(2238, 30)
			-- Perfect Dodge + 6 (refine >= 7)
			if r >= 7 then
			  AddExtParam(0, 51, 6)
			  -- Adds 8% tolerance against Demi-Human monster.
			  AddRaceTolerace(7, 8)
			  -- Adds 8% tolerance against Player (Human) monster.
			  AddRaceTolerace(10, 8)
			  -- Cluster Bomb damage increased by 400%.
			  AddDamage_SKID(1, 2239, 400)
			  -- Aimed Bolt damage increased by 20%.
			  AddDamage_SKID(1, 2236, 20)
			end
			-- Perfect Dodge + 3 (refine >= 9)
			if r >= 9 then
			  AddExtParam(0, 51, 3)
			  -- Adds 4% tolerance against Demi-Human monster.
			  AddRaceTolerace(7, 4)
			  -- Adds 4% tolerance against Player (Human) monster.
			  AddRaceTolerace(10, 4)
			  -- Cluster Bomb damage increased by 200%.
			  AddDamage_SKID(1, 2239, 200)
			  -- Aimed Bolt damage increased by 10%.
			  AddDamage_SKID(1, 2236, 10)
			end
		end
	},
