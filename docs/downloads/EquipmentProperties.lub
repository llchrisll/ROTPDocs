	[3000001026] = {
		Item = { 1631, 22120 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- Judex variable cast time + .@cast%.
			-- Adoramus variable cast time + .@cast%.
			-- (refine >= 7)
			if r >= 7 then
			  local magic = 30
			  if r >= 9 then magic = magic + 20 end
			  -- Increase magical damage against Demon monsters by .@magic%. (scales with refine)
			  AddMdamage_Race(6, magic)
			  -- Increase magical damage against Undead monsters by .@magic%. (scales with refine)
			  AddMdamage_Race(1, magic)
			  -- Increase magical damage on Undead Property enemies by .@magic%. (scales with refine)
			  AddMDamage_Property(9, magic)
			  -- Increase magical damage on Shadow Property enemies by .@magic%. (scales with refine)
			  AddMDamage_Property(7, magic)
			end
			-- Adoramus damage increased by .@dmg + 10*(getskilllv("AB_LAUDAAGNUS")+getskilllv("AB_LAUDARAMUS")+getskilllv("AB_CLEARANCE"))%.
		end
	},
