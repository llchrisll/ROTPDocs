    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Basic ATK + 130+15*(.@r/2) (scales with refine)
      AddExtParam(0, 41, math.floor(130+15*((r)/2)))
      -- DEF + 15*(.@r/2) (scales with refine)
      AddExtParam(0, 45, math.floor(15*((r)/2)))
      -- Ranged Damage + 3%
      -- Melee Damage + 3%
      -- Variable Cast Time + -10% (refine >= 9) (refine >= 7)
      if r >= 7 then
        if r >= 9 then
          AddSpellCastTime(-10)
          -- PAtk + 5
          AddExtParam(0, 242, 5)
          -- Ranged Damage + 5%
          -- Melee Damage + 5%
          -- Aftercast Delay - 5%. (refine >= 12) (refine >= 10)
          if r >= 10 then
            if r >= 12 then
              AddSpellDelay(-5)
            end
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- Aftercast Delay - 5%.
      AddSpellDelay(-5)
      -- POW + 3
      AddExtParam(0, 234, 3)
      -- CON + 3
      AddExtParam(0, 238, 3)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- PAtk + 2
      AddExtParam(0, 242, 2)
      -- ATK + 3%
      AddExtParam(0, 207, 3)
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- PAtk + 3
      AddExtParam(0, 242, 3)
      -- POW + 4
      AddExtParam(0, 234, 4)
      -- CON + 4
      AddExtParam(0, 238, 4)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- PAtk + 5
      AddExtParam(0, 242, 5)
      -- ATK + 4%
      AddExtParam(0, 207, 4)
    end,
    Combiitem = {
      2000003171,
      2000003172,
      2000003173,
      3000004885
    },
  },
