      -- Increases physical damage against All monsters by 4*(.@r/3)%.
      -- Increases magical damage against All monsters by 4*(.@r/3)%.
      -- When Base Level ≥ 175:
      -- All Stats + 15
      AddExtParam(0, 103, 15)
      AddExtParam(0, 104, 15)
      AddExtParam(0, 105, 15)
      AddExtParam(0, 106, 15)
      AddExtParam(0, 107, 15)
      AddExtParam(0, 108, 15)
      -- All Stats + 15 (refine >= 10)
      if r >= 10 then
        AddExtParam(0, 103, 15)
        AddExtParam(0, 104, 15)
        AddExtParam(0, 105, 15)
        AddExtParam(0, 106, 15)
        AddExtParam(0, 107, 15)
        AddExtParam(0, 108, 15)
      end
      -- TODO: if (eaclass()&EAJL_THIRD && BaseJob == Job_Rogue) (condition not translatable)
      -- MaxHP + 15%
      AddExtParam(0, 111, 15)
      -- Increases physical damage to the All monster by 15%.
      RaceAddDamage(9999, 15)
      -- Increase magical damage against All monsters by 15%.
      AddMdamage_Race(9999, 15)
    end,
    Combiitem = {3000005455}
  },
