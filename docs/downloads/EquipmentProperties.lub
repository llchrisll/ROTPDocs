      -- INT + 6
      AddExtParam(0, 106, 6)
      -- INT + .@r-5 (scales with refine)
      AddExtParam(0, 106, (r)-5)
      -- Indestructible (except in upgrade attempts).
      -- SP Consumption + -10% (refine > 5)
      if r > 5 then
        AddSPconsumption(-10)
      end
      -- INT + 5 (refine > 8)
      if r > 8 then
        AddExtParam(0, 106, 5)
      end
    end,
  },
