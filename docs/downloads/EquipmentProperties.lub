      -- Dragon Breath damage increased by 10%.
      AddDamage_SKID(1, 2008, 10)
      -- Dragon Breath - Water damage increased by 10%.
      AddDamage_SKID(1, 5004, 10)
      -- MaxHP + 5% (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 111, 5)
        -- MaxSP + 5%
        AddExtParam(0, 112, 5)
        -- Adds 10% tolerance against Demi-Human monster. (refine >= 9)
        if r >= 9 then
          AddRaceTolerace(7, 10)
          -- Adds 10% tolerance against Player (Doram) monster.
          AddRaceTolerace(11, 10)
          -- Adds 10% tolerance against Player (Human) monster.
          AddRaceTolerace(10, 10)
          -- Adds 10% tolerance against Dragon monster.
          AddRaceTolerace(9, 10)
          -- Aftercast Delay - 10%. (refine >= 11)
          if r >= 11 then
            AddSpellDelay(-10)
            -- DEF + 200 (refine >= 13)
            if r >= 13 then
              AddExtParam(0, 45, 200)
              -- MDEF + 40
              AddExtParam(0, 47, 40)
            end
          end
        end
      end
    end
  },
