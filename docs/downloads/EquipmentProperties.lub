        	if (GetPureJob() == 14 or get(19) == 14 or get(19) == 4015 or get(19) == 4022 or get(19) == 4066 or get(19) == 4073 or get(19) == 4082 or get(19) == 4083 or get(19) == 4102 or get(19) == 4110) then
        		-- Has 1% chance to cast Pressure Lv 5 on attack.
        	end
