    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MaxSP + -10%
      AddExtParam(0, 112, -10)
      -- SPL + 5
      AddExtParam(0, 237, 5)
      -- CON + 5
      AddExtParam(0, 238, 5)
      -- Variable Cast Time + -10%
      AddSpellCastTime(-10)
      -- MATK + 25*(.@r/2) (scales with refine)
      AddExtParam(0, 200, math.floor(25*((r)/2)))
      -- DEF + 10*(.@r/2) (scales with refine)
      AddExtParam(0, 45, math.floor(10*((r)/2)))
      -- All Magic Damage + 25%
      -- Increases MATK + 10%. (refine >= 9) (refine >= 7)
      if r >= 7 then
        if r >= 9 then
          AddExtParam(0, 140, 10)
          -- MATK + 40
          AddExtParam(0, 200, 40)
          -- Increase magical damage on All Property enemies by 12%. (refine >= 11)
          if r >= 11 then
            AddMDamage_Property(10, 12)
            -- SMatk + 12
            AddExtParam(0, 243, 12)
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- Increases MATK + 5%.
      AddExtParam(0, 140, 5)
      -- SPL + 5
      AddExtParam(0, 237, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- Increases magical damage against All monsters by 12%.
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- Increases fixed cast time of all skills by Vms.
      AddSFCTEquipAmount(-500)
      -- SMatk + 2
      AddExtParam(0, 243, 2)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- Increase magical damage against All monsters by 3*(.@r/3)%. (scales with refine)
      AddMdamage_Race(9999, math.floor(3*((r)/3)))
      -- Increase magical damage against Player (Human) monsters by -3*(.@r/3)%. (scales with refine)
      AddMdamage_Race(10, math.floor(-3*((r)/3)))
      -- Increase magical damage against Player (Doram) monsters by -3*(.@r/3)%. (scales with refine)
      AddMdamage_Race(11, math.floor(-3*((r)/3)))
      -- SMatk + 2*(.@r/3) (scales with refine)
      AddExtParam(0, 243, math.floor(2*((r)/3)))
    end,
