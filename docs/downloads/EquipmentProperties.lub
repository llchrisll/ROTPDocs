    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- SPL + 3+.@r (scales with refine)
      AddExtParam(0, 237, 3+(r))
      -- Adds 13% tolerance against Player (Doram) monster.
      AddRaceTolerace(11, 13)
      -- Adds 13% tolerance against Player (Human) monster.
      AddRaceTolerace(10, 13)
      -- Adds 20% damage reduction against Boss monsters.
      ClassSubDamage(1, 20)
      -- Adds 20% damage reduction against Normal monsters.
      ClassSubDamage(0, 20)
      -- Increases MATK + 40%.
      AddExtParam(0, 140, 40)
      -- Soul Vulcan Strike damage increased by BaseLevel/10%.
      -- Mystery Illusion damage increased by BaseLevel/10%.
      -- Deadly Projection damage increased by BaseLevel/10%.
      -- Astral Strike damage increased by BaseLevel/10%.
      -- Aftercast Delay - 20%. (refine >= 10)
      if r >= 10 then
        AddSpellDelay(-20)
        -- Adds 50% magical defense bypassing on All monster.
        SetIgnoreMdefRace(9999, 50)
      end
    end
  },
