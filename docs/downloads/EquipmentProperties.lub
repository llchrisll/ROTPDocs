    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MaxHP + .@r*10 (scales with refine)
      AddExtParam(0, 109, (r)*10)
      -- Increases MATK + 3%.
      AddExtParam(0, 140, 3)
      -- Flee Rate + 10
      AddExtParam(0, 50, 10)
      -- Shadow Magic Damage + 2*(.@r/3)% (scales with refine)
      -- Fire Magic Damage + 2*(.@r/3)% (scales with refine)
      -- Earth Magic Damage + 2*(.@r/3)% (scales with refine)
      -- Water Magic Damage + 2*(.@r/3)% (scales with refine)
