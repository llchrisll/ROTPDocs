      AddExtParam(0, 52, 20)
      -- MaxHP + 15%
      AddExtParam(0, 111, 15)
      -- Increases physical damage to the All monster by 15%.
      RaceAddDamage(9999, 15)
    end,
    Combiitem = {3000005446}
  },
