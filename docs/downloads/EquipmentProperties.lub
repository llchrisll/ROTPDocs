      -- EXP from All + .@r/2% (scales with refine)
      AddEXPPercent_KillRace(9999, math.floor((r)/2))
      -- Drop Rate vs All + .@r/2% (scales with refine)
      AddReceiveItem_Equip(math.floor((r)/2))
      -- MaxHP + 2*(.@r/4)% (scales with refine)
      AddExtParam(0, 111, math.floor(2*((r)/4)))
      -- MaxSP + 2*(.@r/4)% (scales with refine)
