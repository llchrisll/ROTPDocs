	[3000004819] = {
		Item = { 420246, 450257 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- ATK + 5%
			AddExtParam(0, 207, 5)
			-- Perfect HIT + 20%
			-- MaxHP + 5% (refine >= 8)
			if r >= 8 then
			  AddExtParam(0, 111, 5)
			  -- MaxSP + 5%
			  AddExtParam(0, 112, 5)
			end
			-- ATK + 10% (refine >= 9)
			if r >= 9 then
			  AddExtParam(0, 207, 10)
			  -- MaxHP + 10%
			  AddExtParam(0, 111, 10)
			  -- MaxSP + 10%
			  AddExtParam(0, 112, 10)
			end
			-- Cannon Spear cooldown + Vms. (refine >= 10)
			if r >= 10 then
			  AddSkillDelay(2307, -1500)
			  -- Cannon Spear damage increased by 30%.
			  AddDamage_SKID(1, 2307, 30)
			end
			-- Cannon Spear damage increased by BaseLevel/2%.
			-- Banishing Point damage increased by 2*(BaseLevel/2)%. (refine >= 11)
			if r >= 11 then
			end
		end
	},
