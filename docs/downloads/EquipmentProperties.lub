    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Increases physical damage to the All monster by 5*(.@r/3)%. (scales with refine)
      RaceAddDamage(9999, math.floor(5*((r)/3)))
      -- Ranged Damage + 7*(.@r/4)% (scales with refine)
      -- Res + 50 (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 244, 50)
        -- Aftercast Delay - 5%. (refine >= 9)
        if r >= 9 then
          AddSpellDelay(-5)
          -- ASPD + 5%
          AddExtParam(0, 167, 5)
          -- Increases fixed cast time of all skills by Vms. (refine >= 11)
          if r >= 11 then
            AddSFCTEquipAmount(-300)
            -- ATK + 5%
            AddExtParam(0, 207, 5)
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- MaxHP + 5%
      AddExtParam(0, 111, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- PAtk + 3
      AddExtParam(0, 242, 3)
      -- SMatk + 3
      AddExtParam(0, 243, 3)
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- PAtk + 2
      AddExtParam(0, 242, 2)
      -- SMatk + 2
      AddExtParam(0, 243, 2)
      -- POW + 2
      AddExtParam(0, 234, 2)
      -- SPL + 2
      AddExtParam(0, 237, 2)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- MRes + 50
      AddExtParam(0, 245, 50)
      -- Res + 50
      AddExtParam(0, 244, 50)
      -- Increases fixed cast time of all skills by Vms. (refine >= 12)
      if r >= 12 then
        AddSFCTEquipAmount(-200)
      end
    end,
