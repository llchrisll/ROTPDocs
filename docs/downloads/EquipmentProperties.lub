    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- STR + 1
      AddExtParam(0, 103, 1)
      -- ATK + 5%
      AddExtParam(0, 207, 5)
      -- Aftercast Delay - 1%.
      AddSpellDelay(-1)
      -- MaxHP + getrefine()*100 (scales with refine)
      AddExtParam(0, 109, r*100)
      -- Mammonite damage increased by 20%.
      AddDamage_SKID(1, 42, 20)
    end,
    Combiitem = {3000004641}
  },
