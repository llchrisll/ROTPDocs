      2,
      0,
      0,
      0,
      0,
      0,
      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MATK + 10*(.@r/2) (scales with refine)
      AddExtParam(0, 200, math.floor(10*((r)/2)))
      -- Soul Vulcan Strike damage increased by 4*(.@r/3)%. (scales with refine)
      AddDamage_SKID(1, 5220, math.floor(4*((r)/3)))
      -- Floral Flare Road damage increased by 4*(.@r/3)%. (scales with refine)
      AddDamage_SKID(1, 5229, math.floor(4*((r)/3)))
      -- Mystery Illusion damage increased by 4*(.@r/3)%. (scales with refine)
      AddDamage_SKID(1, 5217, math.floor(4*((r)/3)))
      -- Crimson Arrow damage increased by 4*(.@r/3)%. (scales with refine)
      AddDamage_SKID(1, 5235, math.floor(4*((r)/3)))
      -- Ag crimson arrow atk damage increased by 4*(.@r/3)%. (scales with refine)
      AddDamage_SKID(1, 5236, math.floor(4*((r)/3)))
      -- Variable Cast Time + -15% (refine >= 7)
      if r >= 7 then
        AddSpellCastTime(-15)
        -- All Magic Damage + 10%
        -- Increases fixed cast time of all skills by Vms. (refine >= 11) (refine >= 9)
        if r >= 9 then
          if r >= 11 then
            AddSFCTEquipAmount(-300)
            -- Increases MATK + 5%.
            AddExtParam(0, 140, 5)
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- SMatk + 3
      AddExtParam(0, 243, 3)
      -- SPL + 5
      AddExtParam(0, 237, 5)
      -- CON + 5
      AddExtParam(0, 238, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- All Magic Damage + 10%
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- Increases fixed cast time of all skills by Vms.
      AddSFCTEquipAmount(-200)
      -- Increases MATK + 5%.
      AddExtParam(0, 140, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- All Magic Damage + 15%
      -- SMatk + 5
      AddExtParam(0, 243, 5)
    end,
    Combiitem = {
      2000003239,
      2000003240
    },
  },
