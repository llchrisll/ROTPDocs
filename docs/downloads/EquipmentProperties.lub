	[3000001022] = {
		Item = { 1387, 22106 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- Adds 30% tolerance against Demi-Human monster. (refine >= 7)
			if r >= 7 then
			  AddRaceTolerace(7, 30)
			  -- Cart Termination damage increased by 8%. (refine >= 7)
			  if r >= 7 then
			    AddDamage_SKID(1, 485, 8)
			    -- Increases physical damage against Boss monsters by 20%.
			    ClassAddDamage(1, 20)
			  end
			  -- Cart Termination damage increased by 12%. (refine >= 9)
			  if r >= 9 then
			    AddDamage_SKID(1, 485, 12)
			    -- Increases physical damage against Boss monsters by 30%.
			    ClassAddDamage(1, 30)
			  end
			end
		end
	},
