  [27008] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- ATK + 6+.@r% (scales with refine)
      AddExtParam(0, 207, 6+(r))
      -- MATK + 6+.@r% (scales with refine)
      AddExtParam(0, 140, 6+(r))
      -- Lose 6000 HP every ARGms
      -- Lose 6000 SP every ARGms
      -- Add a 10000% resistance against Frozen. (refine >= 9)
      if r >= 9 then
        AddExtParam(0, 251, 10000)
      end
    end,
    Combiitem = {
      3000002539,
      3000002548
    }
  },
