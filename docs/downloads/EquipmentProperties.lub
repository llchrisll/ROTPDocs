	[3000004964] = {
		Item = { 29600, 470263 },
		OnStartEquip = function()
			-- Arrow Storm cooldown + Vms.
			AddSkillDelay(2233, -700)
			-- Increases fixed cast time of all skills by Vms. (scales with refine)
			AddSFCTEquipAmount(math.floor(-200*((GetRefineLevel(2))/4)))
			-- After-cast Delay + -5*(.@r/4)% (scales with refine)
			AddSpellDelay(math.floor(-5*((GetRefineLevel(2))/4)))
			-- Arrow Storm variable cast time + -35*(.@r/4)%. (scales with refine)
			AddSpecificSpellCastTime(2233, math.floor(-35*((GetRefineLevel(2))/4)))
			-- Aimed Bolt variable cast time + -35*(.@r/4)%. (scales with refine)
			AddSpecificSpellCastTime(2236, math.floor(-35*((GetRefineLevel(2))/4)))
		end
	},
