      1,
      0,
      0,
      0,
      0,
      0,
      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- ATK + 4*(.@r/3)% (scales with refine)
      AddExtParam(0, 207, math.floor(4*((r)/3)))
      -- Hack and Slasher damage increased by 5*(.@r/4)%. (scales with refine)
      AddDamage_SKID(1, 5208, math.floor(5*((r)/4)))
      -- Dk servantweapon atk damage increased by 5*(.@r/4)%. (scales with refine)
      AddDamage_SKID(1, 5202, math.floor(5*((r)/4)))
      -- Melee Damage + 10%
      -- Increases physical damage to the All monster by 15%. (refine >= 9) (refine >= 7)
      if r >= 7 then
        if r >= 9 then
          RaceAddDamage(9999, 15)
          -- Increases physical damage to the Player (Human) monster by -15%.
          RaceAddDamage(10, -15)
          -- Increases physical damage to the Player (Doram) monster by -15%.
          RaceAddDamage(11, -15)
          -- PAtk + 7
          AddExtParam(0, 242, 7)
          -- Crit Damage + 15% (refine >= 12)
          if r >= 12 then
            AddDamage_CRI(1, 15)
            -- CRIT + 15
            AddExtParam(0, 52, 15)
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- PAtk + 5
      AddExtParam(0, 242, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- MaxHP + 5%
      AddExtParam(0, 111, 5)
      -- MaxSP + 5%
      AddExtParam(0, 112, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- Melee Damage + 10%
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- Increases physical damage against All monsters by 15%.
    end,
    Combiitem = {3000006081}
  },
