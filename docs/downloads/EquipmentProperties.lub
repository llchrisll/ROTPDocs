	[3000004970] = {
		Item = { 29600, 400116, 470263 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- TODO: autobonus3 "{ bonus2 bSkillAtk,\"RA_AIMEDBOLT\",250; }",1000,30000,"RA_UNLIMIT"
			-- Adds 40% defense bypassing on All monster. (refine >= 35) (refine >= 33)
			if r >= 33 then
			  if r >= 35 then
			    SetIgnoreDefRace_Percent(9999, 40)
			    -- Adds -40% defense bypassing on Player (Doram) monster.
			    SetIgnoreDefRace_Percent(11, -40)
			    -- Adds -40% defense bypassing on Player (Human) monster.
			    SetIgnoreDefRace_Percent(10, -40)
			  end
			end
		end
	},
