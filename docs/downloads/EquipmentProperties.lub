      0,
      0,
      1,
      0,
      0,
      0,
      0,
      0,
      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Increases physical damage to the Player (Human) monster by 20+.@r%. (scales with refine)
      RaceAddDamage(10, 20+(r))
      -- Increases physical damage to the Player (Doram) monster by 20+.@r%. (scales with refine)
      RaceAddDamage(11, 20+(r))
      -- Adds 5% defense bypassing on Player (Human) monster.
      SetIgnoreDefRace_Percent(10, 5)
      -- Adds 5% defense bypassing on Player (Doram) monster.
      SetIgnoreDefRace_Percent(11, 5)
      -- Adds 5% defense bypassing on Player (Human) monster. (refine >= 7)
      if r >= 7 then
        SetIgnoreDefRace_Percent(10, 5)
        -- Adds 5% defense bypassing on Player (Doram) monster.
