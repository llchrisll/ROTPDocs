  [4853] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- STR + 1
      AddExtParam(0, 103, 1)
      -- STR + 3 (refine >= 8)
      if r >= 8 then
        AddExtParam(0, 103, 3)
        -- Increases physical damage against All monsters by 1%.
        -- Reduces fixed casting time by 7%.
        -- ASPD + 1 (refine >= 12) (refine >= 9)
        if r >= 9 then
