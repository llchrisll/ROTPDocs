    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Adds .@r% tolerance against Demi-Human monster. (scales with refine)
      AddRaceTolerace(7, r)
      -- All Stats + 6 (refine >= 6)
      if r >= 6 then
        AddExtParam(0, 103, 6)
        AddExtParam(0, 104, 6)
        AddExtParam(0, 105, 6)
        AddExtParam(0, 106, 6)
        AddExtParam(0, 107, 6)
        AddExtParam(0, 108, 6)
        -- ATK + 6%
        AddExtParam(0, 207, 6)
        -- Increases MATK + 6%.
        AddExtParam(0, 140, 6)
      end
      -- Increase physical damage against Rachel sanctuary monsters by 25%.
      -- Increase magical damage against Rachel sanctuary monsters by 25%. (refine >= 9)
      if r >= 9 then
      end
    end
  },
