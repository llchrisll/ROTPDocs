    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MaxHP + 1500
      AddExtParam(0, 109, 1500)
      -- MaxSP + 150
      AddExtParam(0, 110, 150)
      -- MaxHP + .@r/3% (scales with refine)
      AddExtParam(0, 111, math.floor((r)/3))
      -- MaxSP + .@r/3% (scales with refine)
      AddExtParam(0, 112, math.floor((r)/3))
      -- ATK + 5% (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 207, 5)
        -- Increases MATK + 5%.
        AddExtParam(0, 140, 5)
      end
      -- (refine >= 9)
      if r >= 9 then
        local val = -500
        -- (refine >= 11)
        if r >= 11 then
          val = val - 200
          -- Aftercast Delay - 5%. (refine >= 13)
          if r >= 13 then
            AddSpellDelay(-5)
            -- Variable Cast Time + -5%
            AddSpellCastTime(-5)
          end
        end
        -- Increases fixed cast time of all skills by Vms. (scales with refine)
        AddSFCTEquipAmount(val)
      end
    end,
