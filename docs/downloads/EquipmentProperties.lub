	[3000003714] = {
		Item = { 19140, 490031 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- ASPD + 1 (refine >= 6)
			if r >= 6 then
			  AddExtParam(0, 54, 1)
			  -- Increases physical damage against Boss monsters by 10%.
			  ClassAddDamage(1, 10)
			  -- Crit Damage + 10%
			  AddDamage_CRI(1, 10)
			  -- CRIT (ranged) + 10
			end
			-- ASPD + 1 (refine >= 8)
			if r >= 8 then
			  AddExtParam(0, 54, 1)
			  -- Increases physical damage against Boss monsters by 15%.
			  ClassAddDamage(1, 15)
			  -- Crit Damage + 15%
			  AddDamage_CRI(1, 15)
			  -- CRIT (ranged) + 15
			end
		end
	},
