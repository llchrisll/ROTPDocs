      -- Basic ATK + 25*(.@r/3) (scales with refine)
      AddExtParam(0, 41, math.floor(25*((r)/3)))
      -- Midnight Fallen damage increased by 15%. (refine >= 7)
      if r >= 7 then
        AddDamage_SKID(1, 5501, 15)
        -- Non-Critical Damage + 15%
        -- PAtk + 7 (refine >= 9)
        if r >= 9 then
          AddExtParam(0, 242, 7)
          -- Midnight Fallen damage increased by 15%. (refine >= 12)
          if r >= 12 then
            AddDamage_SKID(1, 5501, 15)
