  [312695] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Basic ATK + (.@r/2) (scales with refine)
      AddExtParam(0, 41, math.floor((r)/2))
      -- Melee Damage + (.@r/3)% (scales with refine)
    end,
  },
  [312696] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Basic ATK + 3*(.@r/2) (scales with refine)
      AddExtParam(0, 41, math.floor(3*((r)/2)))
      -- Melee Damage + (.@r/3)% (scales with refine)
      -- PAtk + (.@r/5) (scales with refine)
      AddExtParam(0, 242, math.floor((r)/5))
    end,
  },
  [312697] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Basic ATK + 5*(.@r/2) (scales with refine)
      AddExtParam(0, 41, math.floor(5*((r)/2)))
      -- Melee Damage + 2*(.@r/3)% (scales with refine)
      -- PAtk + (.@r/4) (scales with refine)
      AddExtParam(0, 242, math.floor((r)/4))
    end,
  },
  [312698] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MATK + (.@r/2) (scales with refine)
      AddExtParam(0, 200, math.floor((r)/2))
      -- Basic ATK + (.@r/2) (scales with refine)
      AddExtParam(0, 41, math.floor((r)/2))
      -- After-cast Delay + -(.@r/3)% (scales with refine)
      AddSpellDelay(math.floor(-((r)/3)))
      -- ASPD + 2*(.@r/3)% (scales with refine)
      AddExtParam(0, 167, math.floor(2*((r)/3)))
    end,
  },
  [312699] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MATK + 3*(.@r/2) (scales with refine)
      AddExtParam(0, 200, math.floor(3*((r)/2)))
      -- Basic ATK + 3*(.@r/2) (scales with refine)
      AddExtParam(0, 41, math.floor(3*((r)/2)))
      -- After-cast Delay + -(.@r/3)% (scales with refine)
      AddSpellDelay(math.floor(-((r)/3)))
      -- ASPD + 2*(.@r/3)% (scales with refine)
      AddExtParam(0, 167, math.floor(2*((r)/3)))
      -- PAtk + (.@r/5) (scales with refine)
      AddExtParam(0, 242, math.floor((r)/5))
      -- SMatk + (.@r/5) (scales with refine)
      AddExtParam(0, 243, math.floor((r)/5))
    end,
