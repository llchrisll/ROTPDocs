  [312095] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- PAtk + 1
      AddExtParam(0, 242, 1)
      -- SMatk + 1
      AddExtParam(0, 243, 1)
      -- Increase magical damage on All Property enemies by 3%. (refine >= 7)
      if r >= 7 then
        AddMDamage_Property(10, 3)
        -- Increase damage on All Property enemies by 3%.
        AddDamage_Property(10, 3)
        -- Increases physical damage against All monsters by 3%.
        -- Increases magical damage against All monsters by 3%.
        -- Increase magical damage against All monsters by 3%. (refine >= 11) (refine >= 9)
        if r >= 9 then
          if r >= 11 then
            AddMdamage_Race(9999, 3)
            -- Increase magical damage against Player (Human) monsters by -3%.
            AddMdamage_Race(10, -3)
            -- Increase magical damage against Player (Doram) monsters by -3%.
            AddMdamage_Race(11, -3)
            -- Increases physical damage to the All monster by 3%.
            RaceAddDamage(9999, 3)
            -- Increases physical damage to the Player (Human) monster by -3%.
            RaceAddDamage(10, -3)
            -- Increases physical damage to the Player (Doram) monster by -3%.
            RaceAddDamage(11, -3)
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- Increases physical damage against Normal monsters by 2%.
      ClassAddDamage(0, 2)
      -- Increases magical damage against Normal monsters by 2%.
      AddMdamage_Class(0, 2)
      -- Increases physical damage against Boss monsters by 2%.
      ClassAddDamage(1, 2)
      -- Increases magical damage against Boss monsters by 2%.
      AddMdamage_Class(1, 2)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- Increases physical damage against Normal monsters by 1%.
      ClassAddDamage(0, 1)
      -- Increases magical damage against Normal monsters by 1%.
      AddMdamage_Class(0, 1)
      -- Increases physical damage against Boss monsters by 1%.
      ClassAddDamage(1, 1)
      -- Increases magical damage against Boss monsters by 1%.
      AddMdamage_Class(1, 1)
    end,
  },
