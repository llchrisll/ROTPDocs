      0,
      0,
      0,
      5,
      0,
      0,
      0,
      0,
      0,
      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Indestructible (except in upgrade attempts).
      -- ATK + 5%
      AddExtParam(0, 207, 5)
      -- POW + 2
      AddExtParam(0, 234, 2)
      -- Triple Laser damage increased by 5%.
      AddDamage_SKID(1, 6003, 5)
      -- Triple Laser damage increased by 10%. (refine >= 5)
      if r >= 5 then
        AddDamage_SKID(1, 6003, 10)
        -- Ranged Damage + 5%
        -- Triple Laser damage increased by 10%. (refine >= 9) (refine >= 7)
        if r >= 7 then
          if r >= 9 then
            AddDamage_SKID(1, 6003, 10)
            -- CRIT + 10 (refine >= 10)
            if r >= 10 then
              AddExtParam(0, 52, 10)
              -- Crit Damage + 20% (refine >= 11)
              if r >= 11 then
                AddDamage_CRI(1, 20)
                -- Triple Laser damage increased by 5%.
                AddDamage_SKID(1, 6003, 5)
              end
            end
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- Ranged Damage + 10%
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- Increases physical damage against All monsters by 10%.
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- Increases physical damage to the All monster by 10%.
      RaceAddDamage(9999, 10)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- Increase damage on All Property enemies by 10%.
      AddDamage_Property(10, 10)
    end,
    Combiitem = {
      2000002532,
      2000002533,
      3000002980
    },
