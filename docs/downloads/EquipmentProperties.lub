		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- MDEF + 5
			AddExtParam(0, 47, 5)
			-- Adds 5% defense bypassing on All monster. (refine >= 9)
			if r >= 9 then
			  SetIgnoreDefRace_Percent(9999, 5)
			  -- Adds 5% magical defense bypassing on All monster.
			  SetIgnoreMdefRace(9999, 5)
			  -- Adds -5% defense bypassing on Player (Human) monster.
			  SetIgnoreDefRace_Percent(10, -5)
			  -- Adds -5% magical defense bypassing on Player (Doram) monster.
			  SetIgnoreMdefRace(11, -5)
			  -- Adds 10% defense bypassing on All monster. (refine >= 12)
			  if r >= 12 then
			    SetIgnoreDefRace_Percent(9999, 10)
			    -- Adds 10% magical defense bypassing on All monster.
			    SetIgnoreMdefRace(9999, 10)
			    -- Adds -10% defense bypassing on Player (Human) monster.
			    SetIgnoreDefRace_Percent(10, -10)
			    -- Adds -10% magical defense bypassing on Player (Doram) monster.
			    SetIgnoreMdefRace(11, -10)
			  end
			end
		end
	},
