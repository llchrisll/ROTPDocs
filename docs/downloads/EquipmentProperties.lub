	[3000004769] = {
		Item = { 490288, 490418 },
		OnStartEquip = function()
			-- Adds 50% defense bypassing on All monster.
			SetIgnoreDefRace_Percent(9999, 50)
			-- Adds -50% defense bypassing on Player (Doram) monster.
			SetIgnoreDefRace_Percent(11, -50)
			-- Adds -50% defense bypassing on Player (Human) monster.
			SetIgnoreDefRace_Percent(10, -50)
			-- TODO: if (eaclass()&EAJL_THIRD && BaseJob == Job_Wizard) (condition not translatable)
			-- Increases fixed cast time of all skills by Vms.
			AddSFCTEquipAmount(-700)
			-- When Base Level < 170:
			-- Crimson Rock cooldown + Vms.
			AddSkillDelay(2211, -4000)
			-- When Base Level ≥ 170:
			-- Crimson Rock cooldown + Vms.
			AddSkillDelay(2211, -1000)
			-- Crimson Rock damage increased by 30%.
			AddDamage_SKID(1, 2211, 30)
			-- TODO: if (eaclass()&EAJL_THIRD && BaseJob == Job_Sage) (condition not translatable)
			-- INT + 30
			AddExtParam(0, 106, 30)
			-- When Base Level < 170:
			-- Varetyr Spear cooldown + Vms.
			AddSkillDelay(2454, -4000)
			-- When Base Level ≥ 170:
			-- Varetyr Spear cooldown + Vms.
			AddSkillDelay(2454, -1000)
			-- Varetyr Spear damage increased by 30%.
			AddDamage_SKID(1, 2454, 30)
		end
	},
