      	-- MaxSP + 100
      	AddExtParam(0, 110, 100)
      end
      if (GetPureJob() == 8 or get(19) == 8) then
      	-- Basic ATK + 50
      	AddExtParam(0, 41, 50)
      	-- MATK + 100
      	AddExtParam(0, 200, 100)
      	-- ASPD + .@r% (scales with refine)
      	AddExtParam(0, 167, r)
      end
      if (GetPureJob() == 15 or get(19) == 15) then
      	-- MaxSP + 200
      	AddExtParam(0, 110, 200)
      	-- SP Consumption + -5%
      	AddSPconsumption(-5)
      	-- Perfect Dodge + .@r (scales with refine)
      	AddExtParam(0, 51, r)
      end
      if (GetPureJob() == 5 or get(19) == 5 or get(19) == 10 or get(19) == 18 or get(19) == 4006 or get(19) == 4011 or get(19) == 4019 or get(19) == 4058 or get(19) == 4068 or get(19) == 4100 or get(19) == 4113 or get(19) == 4224) then
      	-- Basic ATK + 100
      	AddExtParam(0, 41, 100)
      	-- HIT + 10
      	AddExtParam(0, 49, 10)
      	-- Variable Cast Time + -.@r/2% (scales with refine)
      	AddSpellCastTime(math.floor(-(r)/2))
      end
