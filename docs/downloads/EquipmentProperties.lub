	[3000001309] = {
		Item = { 28763, 510067 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- Basic ATK + 10*(.@r/3) (scales with refine)
			AddExtParam(0, 41, math.floor(10*((GetRefineLevel(2) + GetRefineLevel(32))/3)))
			-- ATK + 2*(.@r/5)% (scales with refine)
			AddExtParam(0, 207, math.floor(2*((GetRefineLevel(2) + GetRefineLevel(32))/5)))
			-- (refine >= 14)
			if r >= 14 then
			  local val = 25
			  -- Cross Slash cooldown + Vms. (refine >= 16)
			  if r >= 16 then
			    AddSkillDelay(3004, -2000)
			    -- TODO: skill "KG_KAGEHUMI",.@lvl
			    -- TODO: skill "OB_ZANGETSU",.@lvl (refine >= 18)
			    if r >= 18 then
			      if r >= 20 then val = val + 25 end
			    end
			  end
			  -- Cross Slash damage increased by .@val%. (scales with refine)
