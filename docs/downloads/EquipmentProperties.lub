    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Increases physical damage to the Demi-Human monster by 80%.
      RaceAddDamage(7, 80)
      -- Increases physical damage to the Player (Human) monster by 80%.
      RaceAddDamage(10, 80)
      -- Adds 25% magical defense bypassing on Demi-Human monster.
      SetIgnoreMdefRace(7, 25)
      -- Adds 25% magical defense bypassing on Player (Human) monster.
      SetIgnoreMdefRace(10, 25)
      -- Indestructible (except in upgrade attempts).
      -- Adds 5% magical defense bypassing on Demi-Human monster. (refine > 5)
      if r > 5 then
        SetIgnoreMdefRace(7, 5)
        -- Adds 5% magical defense bypassing on Player (Human) monster.
        SetIgnoreMdefRace(10, 5)
      end
      -- Increases MATK + 5%. (refine > 8)
      if r > 8 then
        AddExtParam(0, 140, 5)
        -- Variable Cast Time + -5%
        AddSpellCastTime(-5)
        -- Aftercast Delay - 5%.
        AddSpellDelay(-5)
      end
    end,
  },
