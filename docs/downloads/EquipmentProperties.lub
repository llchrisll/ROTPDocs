      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Increases physical damage to the Demi-Human monster by 75%.
      RaceAddDamage(7, 75)
      -- Increases physical damage to the Player (Human) monster by 75%.
      RaceAddDamage(10, 75)
      -- Adds 20% defense bypassing on Demi-Human monster.
      SetIgnoreDefRace_Percent(7, 20)
      -- Adds 20% defense bypassing on Player (Human) monster.
      SetIgnoreDefRace_Percent(10, 20)
      -- Indestructible (except in upgrade attempts).
      -- Increases physical damage to the Demi-Human monster by pow(min(14,.@r)-4,2)%. (scales with refine) (refine > 5)
      if r > 5 then
        RaceAddDamage(7, pow(math.min(14,(r))-4,2))
        -- Increases physical damage to the Player (Human) monster by pow(min(14,.@r)-4,2)%. (scales with refine)
        RaceAddDamage(10, pow(math.min(14,(r))-4,2))
        -- Adds 5% defense bypassing on Demi-Human monster.
        SetIgnoreDefRace_Percent(7, 5)
        -- Adds 5% defense bypassing on Player (Human) monster.
        SetIgnoreDefRace_Percent(10, 5)
        -- ASPD + 5%
        AddExtParam(0, 167, 5)
      end
      -- ASPD + 5% (refine > 8)
      if r > 8 then
        AddExtParam(0, 167, 5)
        -- Has 5% chance to cast Critical Wound Lv 1 on attack.
        -- Adds a 200/10% chance to autospell "NPC_CRITICALWOUND" Lv 2 when using Mammonite.
      end
      AddExtParam(0, 228, 1)
    end,
  },
