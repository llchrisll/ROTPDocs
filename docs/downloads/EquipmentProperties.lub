			-- Enable to use Level 10 of Heal
			-- When Base Level ≥ 100:
			-- MATK + 10*.@r (scales with refine)
			AddExtParam(0, 200, 10*(GetRefineLevel(64)))
			-- MDEF + 6*.@r (scales with refine)
			AddExtParam(0, 47, 6*(GetRefineLevel(64)))
			-- (else branch)
			-- MATK + 3*.@r (scales with refine)
			AddExtParam(0, 200, 3*(GetRefineLevel(64)))
			-- MDEF + 3*.@r (scales with refine)
			AddExtParam(0, 47, 3*(GetRefineLevel(64)))
		end
	},
