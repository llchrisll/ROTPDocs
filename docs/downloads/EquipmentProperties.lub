      RaceAddDamage(6, 50)
      -- Increases physical damage to the Undead monster by 50%.
      RaceAddDamage(1, 50)
      -- Has 100+(30*.@r)% chance to cast Soul Destroyer Lv max(getskilllv("ASC_BREAKER"),3) on attack. (scales with refine)
