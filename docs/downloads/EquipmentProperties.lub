  [314889] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- All Stats + .@r/2 (scales with refine)
      AddExtParam(0, 103, math.floor((r)/2))
      AddExtParam(0, 104, math.floor((r)/2))
      AddExtParam(0, 105, math.floor((r)/2))
      AddExtParam(0, 106, math.floor((r)/2))
      AddExtParam(0, 107, math.floor((r)/2))
      AddExtParam(0, 108, math.floor((r)/2))
      -- Melee Damage + 5%
      -- EXP from All + 5% (refine >= 10)
      if r >= 10 then
        AddEXPPercent_KillRace(9999, 5)
        -- Drop Rate vs All + 5%
        AddReceiveItem_Equip(5)
      end
    end
  },
