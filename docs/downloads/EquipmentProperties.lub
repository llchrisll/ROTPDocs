      -- Variable Cast Time + -5%
      AddSpellCastTime(-5)
      -- Midnight Fallen damage increased by 10%.
      AddDamage_SKID(1, 5501, 10)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- PAtk + 15
      AddExtParam(0, 242, 15)
      -- Midnight Fallen cooldown + Vms. (refine >= 12)
      if r >= 12 then
        AddSkillDelay(5501, -200)
      end
    end
