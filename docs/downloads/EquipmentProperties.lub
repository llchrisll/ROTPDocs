    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Weapon is endowed with Water element.
      -- Increases physical damage to the Demon monster by 10%. (refine >= 7)
      if r >= 7 then
        RaceAddDamage(6, 10)
        -- Increases physical damage to the Formless monster by 10%.
        RaceAddDamage(0, 10)
        -- Increase damage on Fire Property enemies by 10%.
        AddDamage_Property(3, 10)
      end
      -- Increases physical damage to the Demon monster by 15%. (refine >= 9)
      if r >= 9 then
        RaceAddDamage(6, 15)
        -- Increases physical damage to the Formless monster by 15%.
        RaceAddDamage(0, 15)
        -- Increase damage on Fire Property enemies by 15%.
        AddDamage_Property(3, 15)
      end
    end
  },
