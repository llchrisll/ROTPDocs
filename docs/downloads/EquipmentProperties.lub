		Item = { 19268, 630060 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- MaxHP + 5%
			AddExtParam(0, 111, 5)
			-- Ranged Damage + 8%
			-- Dragonic Breath damage increased by 20+8*(.@r_weapon/2)%. (scales with refine)
			AddDamage_SKID(1, 6001, math.floor(20+8*((GetRefineLevel(2))/2)))
			-- Dragonic Breath damage increased by 20%. (refine >= 9)
			if r >= 9 then
			  AddDamage_SKID(1, 6001, 20)
			  -- TODO: if (.@r_weapon>=9 && getenchantgrade(EQI_HAND_R)>=ENCHANTGRADE_A) (condition not translatable)
			  -- Dragonic Breath cooldown + Vms.
			  AddSkillDelay(6001, -150)
			  -- MaxHP + 3%
			  AddExtParam(0, 111, 3)
			  -- MaxSP + 5%
			  AddExtParam(0, 112, 5)
			end
		end
	},
