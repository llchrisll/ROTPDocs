    Stat = {
      10,
      0,
      0,
      0,
      0,
      0,
      0,
      0,
      0,
      0,
      2,
      0,
      0,
      0,
      0,
      0,
      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- When Base Level ≥ 210:
      -- SMatk + 1
      AddExtParam(0, 243, 1)
      -- SPL + 2
      AddExtParam(0, 237, 2)
      -- When Base Level ≥ 230:
      -- SMatk + 2
      AddExtParam(0, 243, 2)
      -- SPL + 3
      AddExtParam(0, 237, 3)
      -- Variable Cast Time + -10% (refine >= 7)
      if r >= 7 then
        AddSpellCastTime(-10)
        -- Increases fixed cast time of all skills by Vms. (refine >= 9)
        if r >= 9 then
          AddSFCTEquipAmount(-200)
          -- Increases fixed cast time of all skills by Vms. (refine >= 11)
          if r >= 11 then
            AddSFCTEquipAmount(-300)
            -- Increases MATK + 5%.
            AddExtParam(0, 140, 5)
          end
        end
      end
      -- MATK + 10*(.@r/2) (scales with refine)
      AddExtParam(0, 200, math.floor(10*((r)/2)))
      -- Poison Buster damage increased by 15*(.@r/3)%. (scales with refine)
      AddDamage_SKID(1, 2448, math.floor(15*((r)/3)))
      -- Poison Magic Damage + 7*(.@r/4)% (scales with refine)
      -- Fire Magic Damage + 7*(.@r/4)% (scales with refine)
    end,
    OnStartPretendEquip = true,
    Combiitem = {
      2000002214,
      2000002215
    },
  },
