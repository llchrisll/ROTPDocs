  [300567] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Increases physical damage against All monsters by 4*(.@r/3)%.
      -- When Base Level ≥ 175:
      -- All Stats + 15
      AddExtParam(0, 103, 15)
      AddExtParam(0, 104, 15)
      AddExtParam(0, 105, 15)
      AddExtParam(0, 106, 15)
      AddExtParam(0, 107, 15)
      AddExtParam(0, 108, 15)
      -- All Stats + 15 (refine >= 10)
      if r >= 10 then
        AddExtParam(0, 103, 15)
        AddExtParam(0, 104, 15)
        AddExtParam(0, 105, 15)
        AddExtParam(0, 106, 15)
        AddExtParam(0, 107, 15)
        AddExtParam(0, 108, 15)
      end
      -- TODO: if (eaclass()&EAJL_THIRD && BaseJob == Job_Knight) (condition not translatable)
