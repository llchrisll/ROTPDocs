    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Basic ATK + 120+15*(.@r/2) (scales with refine)
      AddExtParam(0, 41, math.floor(120+15*((r)/2)))
      -- Ranged Damage + 5%
      -- Melee Damage + 5%
      -- ASPD + 10% (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 167, 10)
        -- PAtk + 3 (refine >= 9)
        if r >= 9 then
          AddExtParam(0, 242, 3)
          -- Basic ATK + 25 (refine >= 10)
          if r >= 10 then
            AddExtParam(0, 41, 25)
            -- DEF + 100
            AddExtParam(0, 45, 100)
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- Aftercast Delay - 5%.
      AddSpellDelay(-5)
      -- POW + 3
      AddExtParam(0, 234, 3)
      -- CON + 3
      AddExtParam(0, 238, 3)
