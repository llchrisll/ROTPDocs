  [27121] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      local val = 10
      if r >= 9 then val = val + 5 end
      -- Increases physical damage to the Fish monster by .@val%. (scales with refine)
      RaceAddDamage(5, val)
      -- Increase magical damage against Fish monsters by .@val%. (scales with refine)
      AddMdamage_Race(5, val)
    end,
    Combiitem = {2000001682},
  },
  [27122] = {
