  [27114] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MaxHP + (10+(getrefine()/3))% (scales with refine)
      AddExtParam(0, 111, math.floor(10+(r/3)))
      local val = 50
      -- When Base Level ≥ 160:
      val = val + 50
      -- VIT + 3
      AddExtParam(0, 105, 3)
      -- DEF + .@val (scales with refine)
      AddExtParam(0, 45, val)
    end,
    OnStartPretendEquip = true,
    Combiitem = {
      2000000805,
      3000002787
    },
  },
  [27115] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- INT + 1
      AddExtParam(0, 106, 1)
      -- MaxSP + (80+10*(.@r/2)) (scales with refine)
      AddExtParam(0, 110, math.floor(80+10*((r)/2)))
      -- SP Recovery + 30% (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 114, 30)
      end
    end,
    Combiitem = {2000000805},
  },
