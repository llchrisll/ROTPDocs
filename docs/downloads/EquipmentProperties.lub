      -- Increases physical damage to the Demi-Human monster by 55%.
      RaceAddDamage(7, 55)
      -- Increases physical damage to the Player (Human) monster by 55%.
      RaceAddDamage(10, 55)
      -- Adds 20% defense bypassing on Demi-Human monster.
      SetIgnoreDefRace_Percent(7, 20)
      -- Adds 20% defense bypassing on Player (Human) monster.
