    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- CRate + 10
      AddExtParam(0, 253, 10)
      -- CRIT + 3+(.@r/2) (scales with refine)
      AddExtParam(0, 52, math.floor(3+((r)/2)))
      -- Crit Damage + 3*(.@r/2)% (scales with refine)
      AddDamage_CRI(1, math.floor(3*((r)/2)))
      -- Basic ATK + 15*(.@r/2) (scales with refine)
      AddExtParam(0, 41, math.floor(15*((r)/2)))
      -- Increases physical damage against All monsters by 4*(.@r/3)%.
      -- PAtk + 7 (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 242, 7)
        -- ATK + 5%
        AddExtParam(0, 207, 5)
        -- Aftercast Delay - 10%. (refine >= 9)
        if r >= 9 then
          AddSpellDelay(-10)
          -- CRIT + 7
          AddExtParam(0, 52, 7)
          -- Basic ATK + 45
          AddExtParam(0, 41, 45)
          -- Melee Damage + 15% (refine >= 11)
          if r >= 11 then
          end
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- CRate + 7
      AddExtParam(0, 253, 7)
      -- CRIT + 3
      AddExtParam(0, 52, 3)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- Melee Damage + 10%
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- POW + 5
      AddExtParam(0, 234, 5)
      -- CON + 5
      AddExtParam(0, 238, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- Crit Damage + 15%
      AddDamage_CRI(1, 15)
      -- CRate + 7
      AddExtParam(0, 253, 7)
    end,
    Combiitem = {3000006103}
  },
