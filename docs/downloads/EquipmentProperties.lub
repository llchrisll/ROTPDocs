    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Increases MATK + 5%.
      AddExtParam(0, 140, 5)
      -- Increases MATK + 3%. (refine > 6)
      if r > 6 then
        AddExtParam(0, 140, 3)
      end
      -- Increases MATK + 2%. (refine > 8)
