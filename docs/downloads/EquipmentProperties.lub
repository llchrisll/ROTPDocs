    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- No Knockback
      -- Indestructible (except in upgrade attempts).
      -- An armor that is enchanted with the Water Property.
      if r > 8 then local a = 40 end
      if r <= 8 then
        if r > 6 then a = 25 end
        if r <= 6 then
          if r >= 5 then a = 10 end
        end
      end
      -- Increase damage on Fire Property enemies by .@a%. (scales with refine)
      AddDamage_Property(3, a)
