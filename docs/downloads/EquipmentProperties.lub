	[3000002247] = {
		Item = { 1124, 1304, 29140 },
		OnStartEquip = function()
			-- Has 4% chance to cast Soul Destroyer Lv getskilllv("ASC_BREAKER") on attack.
			-- Basic ATK + 15*(.@r+.@weapon/2) (scales with refine)
			AddExtParam(0, 41, math.floor(15*((GetRefineLevel(32))+(GetRefineLevel(2))/2)))
			-- ASPD + 5*(.@r+.@weapon/2)% (scales with refine)
			AddExtParam(0, 167, math.floor(5*((GetRefineLevel(32))+(GetRefineLevel(2))/2)))
			-- TODO: if ((.@r + .@weapon) >= 20) (condition not translatable)
			-- Add a 10000% resistance against Stunned.
			AddExtParam(0, 247, 10000)
		end
	},
