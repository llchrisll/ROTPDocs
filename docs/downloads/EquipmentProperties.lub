      -- Increases physical damage against Medium monsters by 2%. (refine >= 9)
      if r >= 9 then
        AddDamage_Size(1, 1, 2)
        -- Increases magical damage against Medium monsters by 2%.
        AddMDamage_Size(1, 1, 2)
      end
    end,
    Combiitem = {2000000348},
  },
