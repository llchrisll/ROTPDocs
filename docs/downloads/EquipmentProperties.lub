      -- Indestructible (except in upgrade attempts).
      -- MDEF + -15
      AddExtParam(0, 47, -15)
      -- Adds 10% tolerance against Demon monster.
      AddRaceTolerace(6, 10)
      -- Adds 10% tolerance against Player (Human) monster.
      AddRaceTolerace(10, 10)
      -- Adds 10% tolerance against Player (Doram) monster.
      AddRaceTolerace(11, 10)
      -- ASPD + 2 (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 54, 2)
      end
      -- TODO: if (eaclass()&EAJL_THIRD && BaseJob == Job_Knight) (condition not translatable)
      -- Hundred Spear cooldown + Vms. (refine >= 10)
      if r >= 10 then
        AddSkillDelay(2004, -1000)
        -- TODO: if (eaclass()&EAJL_THIRD && BaseJob == Job_Crusader) (condition not translatable)
        -- Earth Drive fixed cast time + -100%.
      end
      -- HIT + 40 (refine >= 12)
      if r >= 12 then
        AddExtParam(0, 49, 40)
        -- ATK + 5%
        AddExtParam(0, 207, 5)
      end
    end,
