      1,
      0,
      0,
      0,
      0,
      0,
      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      EnableSkill(1013, 1)
      -- Enable to use Level 1 of Greed
      -- When STR ≥ 90:
      -- Basic ATK + (.@r>=9)?30:20 (varies with refine) (refine >= 7)
      if r >= 7 then
        if r >= 9 then
          AddExtParam(0, 41, 30)
        else
          AddExtParam(0, 41, 20)
        end
        -- When INT ≥ 90:
        -- MATK + (.@r>=9)?50:30 (varies with refine)
        if r >= 9 then
          AddExtParam(0, 200, 50)
        else
          AddExtParam(0, 200, 30)
        end
        -- When VIT ≥ 90:
        if r >= 9 then
          AddAttrTolerace(0, 10)
        else
          AddAttrTolerace(0, 5)
        end
        -- When AGI ≥ 90:
        -- ASPD + 8%
        AddExtParam(0, 167, 8)
        -- ASPD + 1 (refine >= 9)
        if r >= 9 then
          AddExtParam(0, 54, 1)
        end
        -- When DEX ≥ 90:
        -- Ranged Damage + (.@r>=9)?10:5% (varies with refine)
        if r >= 9 then
        else
        end
        -- When LUK ≥ 90:
        -- Crit Damage + (.@r>=9)?15:10% (varies with refine)
        if r >= 9 then
          AddDamage_CRI(1, 15)
        else
          AddDamage_CRI(1, 10)
        end
      end
    end,
    OnStartPretendEquip = true
  },
