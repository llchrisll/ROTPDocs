    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Basic ATK + .@r (scales with refine)
      AddExtParam(0, 41, r)
      -- MATK + .@r (scales with refine)
      AddExtParam(0, 200, r)
      -- MaxHP + 1000
      AddExtParam(0, 109, 1000)
      -- MaxSP + 200
      AddExtParam(0, 110, 200)
      -- Adds 3*(getskilllv("SM_SWORD")+.@r)% defense bypassing on Normal monster.
      -- Adds 3*(getskilllv("MG_SRECOVERY")+.@r)% magical defense bypassing on Normal monster.
      -- MaxHP + 5% (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 111, 5)
        -- MaxSP + 5%
        AddExtParam(0, 112, 5)
      end
      -- MaxHP + 5% (refine >= 9)
      if r >= 9 then
        AddExtParam(0, 111, 5)
        -- MaxSP + 5%
        AddExtParam(0, 112, 5)
        -- SP Recovery + 100%
        AddExtParam(0, 114, 100)
      end
    end,
    OnStartPretendEquip = true,
    Combiitem = {
      2000000601,
      2000001818
    },
