      -- Increases physical damage to the Undead monster by 10%.
      RaceAddDamage(1, 10)
      -- Increases physical damage to the Demon monster by 10%.
      RaceAddDamage(6, 10)
      -- (refine >= 9)
      if r >= 9 then
        local dmg = 5
        if r >= 12 then dmg = dmg + 7 end
        -- ATK + .@dmg% (scales with refine)
        AddExtParam(0, 207, dmg)
      end
    end,
  },
