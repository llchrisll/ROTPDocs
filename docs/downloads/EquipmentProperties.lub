            -- TODO: if (getskilllv("NW_WILD_FIRE")>=5) (condition not translatable)
            -- TODO: autobonus3 "{ .@r = getrefine(); bonus bNonCritAtkRate,15; bonus4 bAutoSpellOnSkill,\"NW_SPIRAL_SHOOTING\",\"NW_WILD_FIRE\",5,1000; bonus2 bSkillAtk,\"NW_SPIRAL_SHOOTING\",5*.@r; bonus2 bSkillAtk,\"NW_WILD_FIRE\",5*.@r; }",1000,150000,"NW_HIDDEN_CARD"
          end
        end
