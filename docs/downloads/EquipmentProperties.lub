    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MaxHP + 5%
      AddExtParam(0, 111, 5)
      -- MaxSP + 5%
      AddExtParam(0, 112, 5)
      -- MDEF + 15
      AddExtParam(0, 47, 15)
      -- When INT ≥ 108:
      -- Dragon Breath damage increased by 15%.
      AddDamage_SKID(1, 2008, 15)
      -- When DEX ≥ 108:
      -- Dragon Breath - Water damage increased by 15%.
      AddDamage_SKID(1, 5004, 15)
