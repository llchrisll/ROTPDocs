  [300443] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- ATK + 5%
      AddExtParam(0, 207, 5)
      -- Increase damage on Earth Property enemies by 10%. (refine >= 7)
      if r >= 7 then
        AddDamage_Property(2, 10)
        -- Increase damage on Earth Property enemies by 7%. (refine >= 9)
        if r >= 9 then
          AddDamage_Property(2, 7)
        end
      end
    end,
  },
