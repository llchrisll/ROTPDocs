      0,
      0,
      0,
      4,
      0,
      0,
      0,
      0,
      0,
      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Increases physical damage to the Demi-Human monster by 70%.
      RaceAddDamage(7, 70)
      -- Increases physical damage to the Player (Human) monster by 70%.
      RaceAddDamage(10, 70)
      -- Adds 25% defense bypassing on Demi-Human monster.
      SetIgnoreDefRace_Percent(7, 25)
      -- Adds 25% defense bypassing on Player (Human) monster.
      SetIgnoreDefRace_Percent(10, 25)
      -- Indestructible (except in upgrade attempts).
      -- Increases physical damage to the Demi-Human monster by pow(min(14,.@r)-4,2)%. (scales with refine) (refine > 5)
      if r > 5 then
        RaceAddDamage(7, pow(math.min(14,(r))-4,2))
        -- Increases physical damage to the Player (Human) monster by pow(min(14,.@r)-4,2)%. (scales with refine)
        RaceAddDamage(10, pow(math.min(14,(r))-4,2))
        -- Adds 5% defense bypassing on Demi-Human monster.
        SetIgnoreDefRace_Percent(7, 5)
        -- Adds 5% defense bypassing on Player (Human) monster.
        SetIgnoreDefRace_Percent(10, 5)
      end
      -- (refine > 8)
      if r > 8 then
        if (GetPureJob() == 7 or get(19) == 7 or get(19) == 13 or get(19) == 4008 or get(19) == 4014 or get(19) == 4030 or get(19) == 4036 or get(19) == 4054 or get(19) == 4060 or get(19) == 4066 or get(19) == 4073 or get(19) == 4080 or get(19) == 4081 or get(19) == 4082 or get(19) == 4083 or get(19) == 4088 or get(19) == 4089 or get(19) == 4090 or get(19) == 4091 or get(19) == 4092 or get(19) == 4093 or get(19) == 4094 or get(19) == 4095 or get(19) == 4096 or get(19) == 4102 or get(19) == 4109 or get(19) == 4110 or get(19) == 4252 or get(19) == 4265 or get(19) == 4280) then
        	-- Adds a 200/10% chance to autospell "NPC_CRITICALWOUND" Lv 2 when using Pierce.
        end
        if not ((GetPureJob() == 7 or get(19) == 7 or get(19) == 13 or get(19) == 4008 or get(19) == 4014 or get(19) == 4030 or get(19) == 4036 or get(19) == 4054 or get(19) == 4060 or get(19) == 4066 or get(19) == 4073 or get(19) == 4080 or get(19) == 4081 or get(19) == 4082 or get(19) == 4083 or get(19) == 4088 or get(19) == 4089 or get(19) == 4090 or get(19) == 4091 or get(19) == 4092 or get(19) == 4093 or get(19) == 4094 or get(19) == 4095 or get(19) == 4096 or get(19) == 4102 or get(19) == 4109 or get(19) == 4110 or get(19) == 4252 or get(19) == 4265 or get(19) == 4280)) then
        	if (GetPureJob() == 14 or get(19) == 14 or get(19) == 4015 or get(19) == 4022 or get(19) == 4066 or get(19) == 4073 or get(19) == 4082 or get(19) == 4083 or get(19) == 4102 or get(19) == 4110) then
        		-- Has 2% chance to cast Pressure Lv 5 on attack.
        	end
        end
      end
      AddExtParam(0, 212, 1)
    end,
  },
