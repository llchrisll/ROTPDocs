      AddMDamage_Property(3, a)
      -- Increase magical damage on Water Property enemies by .@a%. (scales with refine)
      AddMDamage_Property(1, a)
      -- Increases physical damage to the Demi-Human monster by .@a%. (scales with refine)
      RaceAddDamage(7, a)
      -- Increases physical damage to the Formless monster by .@a%. (scales with refine)
      RaceAddDamage(0, a)
      -- Increase magical damage against Demi-Human monsters by .@a%. (scales with refine)
      AddMdamage_Race(7, a)
      -- Increase magical damage against Formless monsters by .@a%. (scales with refine)
      AddMdamage_Race(0, a)
      -- Increases physical damage to the Player (Human) monster by .@a%. (scales with refine)
      RaceAddDamage(10, a)
      -- Increase magical damage against Player (Human) monsters by .@a%. (scales with refine)
      AddMdamage_Race(10, a)
      -- Increases physical damage to the Player (Doram) monster by .@a%. (scales with refine)
      RaceAddDamage(11, a)
      -- Increase magical damage against Player (Doram) monsters by .@a%. (scales with refine)
      AddMdamage_Race(11, a)
    end
  },
