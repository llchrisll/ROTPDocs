      -- MATK + .@r (scales with refine)
      AddExtParam(0, 200, r)
      -- Increases physical damage against Medium monsters by 2%.
      AddDamage_Size(1, 1, 2)
      -- Increases magical damage against Medium monsters by 2%.
      AddMDamage_Size(1, 1, 2)
      -- Increases physical damage against Medium monsters by 1%. (refine >= 7)
