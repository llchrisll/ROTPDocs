  [300195] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Increases physical damage to the Insect monster by 20%.
      RaceAddDamage(4, 20)
      -- Increases physical damage to the Brute monster by 20%.
      RaceAddDamage(2, 20)
      -- Increases physical damage to the Player (Doram) monster by 20%.
      RaceAddDamage(11, 20)
      -- Increase damage on Earth Property enemies by 20%.
      AddDamage_Property(2, 20)
      -- Increase damage on Wind Property enemies by 20%.
      AddDamage_Property(4, 20)
      -- Increases physical damage to the Insect monster by 10%. (refine >= 15)
      if r >= 15 then
        RaceAddDamage(4, 10)
        -- Increases physical damage to the Brute monster by 10%.
        RaceAddDamage(2, 10)
        -- Increases physical damage to the Player (Doram) monster by 10%.
        RaceAddDamage(11, 10)
        -- Increase damage on Earth Property enemies by 10%.
        AddDamage_Property(2, 10)
        -- Increase damage on Wind Property enemies by 10%.
        AddDamage_Property(4, 10)
      end
    end,
    Combiitem = {2000002809},
