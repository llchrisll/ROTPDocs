    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Basic ATK + .@r (scales with refine)
      AddExtParam(0, 41, r)
      -- MATK + .@r (scales with refine)
      AddExtParam(0, 200, r)
      -- When Base Level < 175:
      -- EXP from All + 20%
      AddEXPPercent_KillRace(9999, 20)
      -- When Base Level ≥ 175:
      -- EXP from All + 10%
      AddEXPPercent_KillRace(9999, 10)
      -- EXP from All + 5% (refine >= 10)
      if r >= 10 then
        AddEXPPercent_KillRace(9999, 5)
      end
      -- EXP from All + (.@r/2)% (scales with refine)
      AddEXPPercent_KillRace(9999, math.floor((r)/2))
    end,
    OnStartPretendEquip = true
  },
