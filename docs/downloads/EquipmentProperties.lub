	[3000004654] = {
		Item = { 400486, 480342 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- Aftercast Delay - 10%.
			AddSpellDelay(-10)
			-- Increase damage on Ghost Property enemies by 15%. (refine >= 7)
			if r >= 7 then
			  AddDamage_Property(8, 15)
			  -- Increase damage on Undead Property enemies by 15%.
			  AddDamage_Property(9, 15)
			  -- Increase magical damage on Ghost Property enemies by 15%.
			  AddMDamage_Property(8, 15)
			  -- Increase magical damage on Undead Property enemies by 15%.
			  AddMDamage_Property(9, 15)
			end
			-- Increases physical damage to the Demon monster by 15%. (refine >= 9)
			if r >= 9 then
			  RaceAddDamage(6, 15)
			  -- Increases physical damage to the Undead monster by 15%.
			  RaceAddDamage(1, 15)
			  -- Increase magical damage against Demon monsters by 15%.
			  AddMdamage_Race(6, 15)
			  -- Increase magical damage against Undead monsters by 15%.
			  AddMdamage_Race(1, 15)
			end
			-- Increases physical damage against Medium monsters by 15%. (refine >= 11)
			if r >= 11 then
			  AddDamage_Size(1, 1, 15)
			  -- Increases physical damage against Large monsters by 15%.
			  AddDamage_Size(1, 2, 15)
			  -- Increases magical damage against Medium monsters by 15%.
			  AddMDamage_Size(1, 1, 15)
			  -- Increases magical damage against Large monsters by 15%.
			  AddMDamage_Size(1, 2, 15)
			end
		end
	},
