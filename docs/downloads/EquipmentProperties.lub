	[3000001296] = {
		Item = { 1414, 28506 },
		OnStartEquip = function()
			local r = GetRefineLevel(GetLocation())
			-- (refine >= 7)
			if r >= 7 then
			  local val = 30
			  -- (refine >= 9)
			  if r >= 9 then
			    val = val + 20
			    -- Increases physical damage against Boss monsters by .@val%. (scales with refine)
			    ClassAddDamage(1, val)
			    -- Increase damage on Water Property enemies by .@val%. (scales with refine)
			    AddDamage_Property(1, val)
			    -- Increase damage on Wind Property enemies by .@val%. (scales with refine)
			    AddDamage_Property(4, val)
			    -- Increases physical damage to the Fish monster by .@val%. (scales with refine)
			    RaceAddDamage(5, val)
			    -- Increases physical damage to the Insect monster by .@val%. (scales with refine)
			    RaceAddDamage(4, val)
			    -- Wind Cutter damage increased by .@val%. (scales with refine)
			    AddDamage_SKID(1, 2005, val)
			    -- Wind Cutter variable cast time + -50%. (refine >= 10)
			    if r >= 10 then
			      AddSpecificSpellCastTime(2005, -50)
			    end
			  end
			end
		end
	},
