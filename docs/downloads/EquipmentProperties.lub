      0,
      0
    },
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- When Base Level ≥ 250:
      -- PAtk + 8
      AddExtParam(0, 242, 8)
      -- SMatk + 8
      AddExtParam(0, 243, 8)
      -- Increases physical damage to the Angel monster by 7%. (refine >= 9)
      if r >= 9 then
        RaceAddDamage(8, 7)
        -- Increase magical damage against Angel monsters by 7%.
        AddMdamage_Race(8, 7)
        -- Increases physical damage to the Dragon monster by 7%.
        RaceAddDamage(9, 7)
        -- Increase magical damage against Dragon monsters by 7%.
        AddMdamage_Race(9, 7)
        -- Increases physical damage to the Angel monster by 7%. (refine >= 11)
        if r >= 11 then
          RaceAddDamage(8, 7)
          -- Increase magical damage against Angel monsters by 7%.
          AddMdamage_Race(8, 7)
          -- Increases physical damage to the Dragon monster by 7%.
          RaceAddDamage(9, 7)
          -- Increase magical damage against Dragon monsters by 7%.
          AddMdamage_Race(9, 7)
        end
      end
      -- TODO: if (.@g>=ENCHANTGRADE_D) (condition not translatable)
      -- PAtk + 5
      AddExtParam(0, 242, 5)
      -- SMatk + 5
      AddExtParam(0, 243, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_C) (condition not translatable)
      -- Disregards 5% of the target's Res against Angel monsters.
      AddIgnore_RES_RacePercent(8, 5)
      -- Disregards 5% of the target's Res against Dragon monsters.
      AddIgnore_RES_RacePercent(9, 5)
      -- Disregards 5% of the target's MRes against Angel monsters.
      AddIgnore_MRES_RacePercent(8, 5)
      -- Disregards 5% of the target's MRes against Dragon monsters.
      AddIgnore_MRES_RacePercent(9, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_B) (condition not translatable)
      -- Disregards 5% of the target's Res against Angel monsters.
      AddIgnore_RES_RacePercent(8, 5)
      -- Disregards 5% of the target's Res against Dragon monsters.
      AddIgnore_RES_RacePercent(9, 5)
      -- Disregards 5% of the target's MRes against Angel monsters.
      AddIgnore_MRES_RacePercent(8, 5)
      -- Disregards 5% of the target's MRes against Dragon monsters.
      AddIgnore_MRES_RacePercent(9, 5)
      -- TODO: if (.@g>=ENCHANTGRADE_A) (condition not translatable)
      -- Disregards 5% of the target's Res against Angel monsters.
      AddIgnore_RES_RacePercent(8, 5)
      -- Disregards 5% of the target's Res against Dragon monsters.
      AddIgnore_RES_RacePercent(9, 5)
      -- Disregards 5% of the target's MRes against Angel monsters.
      AddIgnore_MRES_RacePercent(8, 5)
      -- Disregards 5% of the target's MRes against Dragon monsters.
      AddIgnore_MRES_RacePercent(9, 5)
      -- Melee Damage + 3*(.@r/2)% (scales with refine)
      -- Ranged Damage + 3*(.@r/2)% (scales with refine)
      -- All Magic Damage + 3*(.@r/2)% (scales with refine)
      -- Increases physical damage against Medium monsters by 5*(.@r/4)%. (scales with refine)
      AddDamage_Size(1, 1, math.floor(5*((r)/4)))
      -- Increases magical damage against Medium monsters by 5*(.@r/4)%. (scales with refine)
      AddMDamage_Size(1, 1, math.floor(5*((r)/4)))
      -- Increases physical damage against Large monsters by 5*(.@r/4)%. (scales with refine)
      AddDamage_Size(1, 2, math.floor(5*((r)/4)))
      -- Increases magical damage against Large monsters by 5*(.@r/4)%. (scales with refine)
      AddMDamage_Size(1, 2, math.floor(5*((r)/4)))
    end,
    OnStartPretendEquip = true,
    Combiitem = {
      2000002953,
      2000002954,
      2000002955
    },
