  [29511] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- Adds 1+(.@r/3)% tolerance against Player (Human) monster. (scales with refine)
      AddRaceTolerace(10, math.floor(1+((r)/3)))
      -- Adds 1+(.@r/3)% tolerance against Player (Doram) monster. (scales with refine)
      AddRaceTolerace(11, math.floor(1+((r)/3)))
    end,
    Combiitem = {3000003158}
  },
  [29512] = {
    Type = "card",
    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- MaxHP + 5%
      AddExtParam(0, 111, 5)
      -- MaxSP + 5%
      AddExtParam(0, 112, 5)
      -- Adds 5% tolerance against Player (Doram) monster.
      AddRaceTolerace(11, 5)
      -- DEF + 50 (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 45, 50)
        -- MDEF + 5
        AddExtParam(0, 47, 5)
        -- Adds 5% tolerance against Player (Doram) monster.
        AddRaceTolerace(11, 5)
      end
      -- DEF + 50 (refine >= 9)
      if r >= 9 then
        AddExtParam(0, 45, 50)
        -- MDEF + 5
        AddExtParam(0, 47, 5)
        -- Adds 2% tolerance against Player (Doram) monster.
        AddRaceTolerace(11, 2)
      end
    end
  },
