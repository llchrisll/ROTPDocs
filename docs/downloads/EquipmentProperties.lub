    OnStartEquip = function()
      local r = GetRefineLevel(GetLocation())
      -- AGI + .@r/2 (scales with refine)
      AddExtParam(0, 104, math.floor((r)/2))
      -- LUK + .@r/2 (scales with refine)
      AddExtParam(0, 108, math.floor((r)/2))
      -- ASPD + 5% (refine >= 7)
      if r >= 7 then
        AddExtParam(0, 167, 5)
        -- ASPD + 5% (refine >= 9)
        if r >= 9 then
          AddExtParam(0, 167, 5)
          -- CRIT + 5
          AddExtParam(0, 52, 5)
        end
      end
    end
  },
