      -- Increases magical damage against Medium monsters by 12+4*(.@r/3)%. (scales with refine)
      AddMDamage_Size(1, 1, math.floor(12+4*((r)/3)))
    end,
    Combiitem = {
      2000002797,
      2000002798,
      2000002799
    },
